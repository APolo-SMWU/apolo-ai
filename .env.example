# 로컬 PostgreSQL: 실제 비밀번호는 Git에서 제외된 .env에만 입력한다.
AI_DB_HOST=127.0.0.1
AI_DB_PORT=5432
AI_DB_NAME=apolo_dev
AI_DB_USER=apolo_ai
AI_DB_PASSWORD=

# GitHub 공개 API 요청에 사용할 선택 토큰
GITHUB_TOKEN=

# Graph A 후보 추출 LLM: 실제 키는 Git에서 제외된 .env에만 입력한다.
OPENAI_API_KEY=
APOLO_EXTRACTION_MODEL=gpt-5.6-luna

# LangSmith tracing: 실제 키는 Git에서 제외된 .env에만 입력한다.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=apolo-ai

# 합성 평가 케이스 로컬 검증
# uv run python -m evals.local_runner

# 합성 평가 케이스를 LangSmith Dataset에 업로드
# LANGSMITH_API_KEY를 입력한 뒤 실행한다.
# uv run python -m evals.langsmith_dataset

# LangSmith 온라인 평가는 애플리케이션 target을 연결한 뒤
# evals.langsmith_evaluator.run_langsmith_evaluation(...)을 호출
